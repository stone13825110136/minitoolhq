---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Path only, e.g. /tools/amazon-image-prep — used for canonical + OG */
  path?: string;
}

const {
  title,
  description = "Private browser tools for creators & sellers. Files stay on your device.",
  path = Astro.url.pathname,
} = Astro.props;

const site = Astro.site?.href.replace(/\/$/, "") ?? "https://minitoolhq.com";
const canonical = new URL(path.startsWith("/") ? path : `/${path}`, `${site}/`).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MiniTool HQ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">MiniTool <span>HQ</span></a>
      <nav class="nav" aria-label="Primary">
        <a href="/tools/amazon-image-prep">Amazon Prep</a>
        <a href="/#tools">Tools</a>
        <a href="/#report-issue">Report issue</a>
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        MiniTool HQ — private browser tools for creators &amp; sellers. Processing stays on your
        device.
      </p>
      <p class="footer-quiet">
        Found a bug?
        <a href="/#report-issue">Report it</a>
        for free usage credit ·
        <a href="mailto:contact@minitoolhq.com">contact@minitoolhq.com</a>
        <span class="footer-sep">·</span>
        <a href="/#value">About</a>
      </p>
    </footer>
  </body>
</html>
