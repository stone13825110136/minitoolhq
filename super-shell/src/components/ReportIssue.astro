---
/** Shared copy for bug reports */
const FEEDBACK_EMAIL = "contact@selltoolhq.com";

const feedbackMailto = `mailto:${FEEDBACK_EMAIL}?subject=${encodeURIComponent(
  "SellTool HQ — tool issue report",
)}&body=${encodeURIComponent(
  [
    "Tool name:",
    "Page URL:",
    "What went wrong:",
    "Steps to reproduce:",
    "Browser / device:",
    "Screenshot or sample file notes (optional):",
  ].join("\n"),
)}`;
---

<section id="report-issue" class="section report-block">
  <h2>Found a problem? Tell us</h2>
  <p class="lede">
    If a tool breaks, looks wrong, or fails your workflow, please report it. Confirmed useful
    bug reports help us fix issues faster. No account required.
  </p>
  <ul class="report-list">
    <li>Include the tool name, what you expected, and what happened</li>
    <li>Add steps to reproduce (and browser if you know it)</li>
    <li>Optional: a sample file note or screenshot description</li>
  </ul>
  <div class="actions">
    <a class="btn btn-primary" href={feedbackMailto}>Report a tool issue</a>
    <a class="btn btn-ghost" href={`mailto:${FEEDBACK_EMAIL}`}>{FEEDBACK_EMAIL}</a>
  </div>
</section>
