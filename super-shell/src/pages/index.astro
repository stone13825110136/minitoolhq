---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReportIssue from "../components/ReportIssue.astro";

const pageTitle =
  "SellTool HQ - Image Tools, Title Character Counter & FBA Box Checker";
const pageDescription =
  "Free private browser tools for sellers: marketplace image resizer, HEIC/PNG convert, image compressor, Amazon title character counter, and FBA box size checker - no upload, no signup.";

const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "SellTool HQ",
  url: "https://selltoolhq.com/",
  description: pageDescription,
};
---

<BaseLayout title={pageTitle} description={pageDescription} path="/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
  </Fragment>

  <section class="hero-home">
    <p class="badge">Private · In-browser · No upload</p>
    <p class="brand-mark">SellTool HQ</p>
    <h1>Private tools for creators &amp; sellers.</h1>
    <p class="lede">
      Resize marketplace listing photos, convert <strong>HEIC to JPG</strong> or
      <strong>PNG to JPG</strong>, <strong>compress images</strong>, count
      <strong>Amazon title characters</strong> (75), and check
      <strong>Amazon FBA box size</strong> - all in your browser, files stay on your device.
    </p>
  </section>

  <section id="tools" class="section tools-first">
    <h2>Tools</h2>
    <div class="tool-cards">
      <a class="tool-card" href="/tools/marketplace-image-prep">
        <h2>Marketplace Image Resizer</h2>
        <p>
          One tool for Amazon, TikTok Shop, Etsy, eBay, Shopify &amp; Walmart — square sizes, white
          background, strip EXIF, ZIP. No upload.
        </p>
      </a>
      <a class="tool-card" href="/tools/heic-to-jpg">
        <h2>HEIC to JPG Converter</h2>
        <p>
          Batch convert iPhone HEIC photos to JPG in your browser — free ZIP download, no upload.
        </p>
      </a>
      <a class="tool-card" href="/tools/png-to-jpg">
        <h2>PNG to JPG Converter</h2>
        <p>
          Free PNG to JPG, WebP to JPG, and JPG to PNG batch converter - ZIP download, no upload.
        </p>
      </a>
      <a class="tool-card" href="/tools/image-compressor">
        <h2>Image Compressor</h2>
        <p>
          Free batch image compressor - quality or target KB (e.g. 100KB), ZIP download, no upload.
        </p>
      </a>
      <a class="tool-card" href="/tools/listing-character-counter">
        <h2>Amazon Title Character Counter</h2>
        <p>
          Count Amazon titles (75), Item Highlights (125), bullets, backend bytes, plus Etsy 140 —
          live in your browser.
        </p>
      </a>
      <a class="tool-card" href="/tools/fba-box-size-checker">
        <h2>FBA Box Size Checker</h2>
        <p>
          Check FBA box dimensions and carton size — Pass/Fail for FBA 36×25×25 vs AWD 25×25×25.
          Free, unlimited, in-browser.
        </p>
      </a>
    </div>
  </section>

  <section id="guides" class="section">
    <h2>Guides</h2>
    <p class="lede">
      <a href="/guides/amazon-product-image-size">Amazon image size</a>
      ·
      <a href="/guides/etsy-listing-photo-size">Etsy photo size</a>
      ·
      <a href="/guides/tiktok-shop-image-size">TikTok Shop size</a>
      ·
      <a href="/guides/amazon-fba-box-size-limits">FBA box limits</a>
      ·
      <a href="/guides/amazon-dimensional-weight">Dimensional weight</a>
      ·
      <a href="/guides/heic-to-jpg-for-amazon">HEIC for Amazon</a>
      ·
      <a href="/guides/heic-to-jpg-for-etsy">HEIC for Etsy</a>
      ·
      <a href="/guides/heic-to-jpg-for-tiktok-shop">HEIC for TikTok Shop</a>
      ·
      <a href="/guides/png-to-jpg-for-amazon">PNG to JPG for Amazon</a>
      ·
      <a href="/guides/amazon-title-character-limit">Amazon title 75 chars</a>
      ·
      <a href="/guides/amazon-item-highlights">Item Highlights</a>
      ·
      <a href="/guides/etsy-title-character-limit">Etsy title 140</a>
    </p>
  </section>

  <section id="value" class="section value-block">
    <h2>What you get</h2>
    <p class="lede">
      Tools built for marketplace and creator work — with defaults that match common listing and
      inbound rules — while your files stay on your device.
    </p>
    <div class="value-grid">
      <div class="value-item">
        <h3>Ready for the platform</h3>
        <p>
          Amazon listing sizes, FBA carton limits, and more presets aimed at what Seller Central
          and shops actually expect — less guesswork before you upload or ship.
        </p>
      </div>
      <div class="value-item">
        <h3>Your files stay private</h3>
        <p>
          Processing runs in your browser. Product photos and carton numbers are not uploaded to
          our servers. You can verify in DevTools → Network.
        </p>
      </div>
      <div class="value-item">
        <h3>Batch when you need it</h3>
        <p>
          Prep several listing images or check multiple cartons in one pass, then download or
          review results without creating an account first.
        </p>
      </div>
      <div class="value-item">
        <h3>Free to use</h3>
        <p>
          Core tools are free with no account required. Prep listings or check cartons and
          download results in your browser.
        </p>
      </div>
    </div>
  </section>

  <ReportIssue />
</BaseLayout>
