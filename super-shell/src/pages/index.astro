---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="MiniTool HQ — Private Browser Tools for Creators & Sellers"
  description="Free, private, browser-based micro tools. Files stay on your device. No signup for core tools."
>
  <section class="hero-home">
    <p class="badge">Free core · Local processing · $4.99/mo Pro</p>
    <p class="brand-mark">MiniTool HQ</p>
    <h1>Private tools for creators &amp; sellers.</h1>
    <p class="lede">
      Browser micro-tools that keep files on your device. Start with Amazon listing photo prep —
      more tools shipping continuously.
    </p>
  </section>

  <section id="tools" class="section">
    <h2>Tools</h2>
    <div class="tool-cards">
      <a class="tool-card" href="/tools/amazon-image-prep">
        <h2>Amazon Image Prep</h2>
        <p>
          Batch resize to ~2000px, optional white background, strip EXIF/GPS, ZIP download. No
          upload.
        </p>
      </a>
      <div class="tool-card" style="opacity: 0.55; cursor: default;">
        <h2>Image Compressor</h2>
        <p>Next up — private batch compression. Same Pro unlock.</p>
      </div>
    </div>
  </section>
</BaseLayout>
