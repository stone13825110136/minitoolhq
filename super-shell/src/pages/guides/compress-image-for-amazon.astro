---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReportIssue from "../../components/ReportIssue.astro";
import SpecLegend from "../../components/SpecLegend.astro";
import GuideDisclaimer from "../../components/GuideDisclaimer.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import RelatedGuides from "../../components/RelatedGuides.astro";

const pageTitle = "Compress Image for Amazon Listings - Stay Under Size Limits";
const pageDescription =
  "Compress images for Amazon Seller Central without uploading. Shrink JPG/PNG for faster listing uploads, then resize for zoom — free browser tool.";

const faqs: { q: string; a: string }[] = [
  {
    q: "How do I compress an image for Amazon listings?",
    a: "Use a free image compressor in your browser: drop JPG/PNG/WebP product photos, pick quality or a target file size, download a ZIP, then upload in Seller Central. Compressing does not replace meeting Amazon’s pixel / zoom size rules.",
  },
  {
    q: "What file size does Amazon allow for product images?",
    a: "Amazon’s listing image guidance commonly cites a maximum around 10 MB per image. Many sellers still compress toward a few hundred KB–2 MB for faster uploads. Always confirm the current Seller Central help page for your marketplace.",
  },
  {
    q: "Does Amazon require images under 100KB?",
    a: "No. 100KB is a common web/email target, not an Amazon listing rule. Amazon cares more about format, white background on the main image, and enough pixels for zoom (about 1000px+ on the longest side).",
  },
  {
    q: "Should I compress before or after resizing for Amazon?",
    a: "Best practice: convert HEIC/PNG if needed, resize to your Amazon master (often 2000×2000), then compress if the file is still heavy. Order can vary; never shrink pixels below the zoom floor just to hit a tiny KB number.",
  },
  {
    q: "Can I compress Amazon images without uploading them?",
    a: "Yes. SellTool HQ’s image compressor runs in your browser so product photos are not sent to our servers. Open DevTools → Network while compressing if you want to verify.",
  },
  {
    q: "JPG or PNG after compress for Amazon?",
    a: "JPEG is preferred for most listing photos. Keep PNG when you still need transparency for later edits. Our compressor can output JPG for maximum size reduction.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Guides", path: "/#guides" },
  { name: "Compress image for Amazon", path: "/guides/compress-image-for-amazon" },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/guides/compress-image-for-amazon"
  crumbs={crumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <article class="guide-body">
    <p class="badge">Guide · Amazon sellers · Updated 2026</p>
    <h1>Compress image for Amazon listings</h1>
    <p class="lede">
      Large studio or phone exports can fail slow uploads or waste time in Seller Central. Learn how
      to <strong>compress images for Amazon</strong> listings safely — keep zoom-ready pixels, prefer
      JPEG, and shrink file size <strong>in your browser</strong> without uploading product photos.
    </p>

    <SpecLegend />

    <div class="guide-cta">
      <p>Batch compress JPG / PNG / WebP with quality or target KB — no upload.</p>
      <a class="btn btn-primary" href="/tools/image-compressor">Open Image Compressor</a>
    </div>

    <h2>Amazon cares about pixels and format first</h2>
    <p>
      Before you chase a tiny file size, meet listing basics: accepted formats (JPEG preferred), main
      image white background rules, and enough resolution for zoom (longest side at least about
      <strong>1000px</strong>; many sellers use <strong>1600px+</strong> or a
      <strong>2000×2000</strong> square master).
      <em
        >Source: Amazon Seller Central product image requirements / seller help summaries (reviewed
        2026).</em
      >
    </p>
    <p>
      Compressing only reduces bytes. It does <strong>not</strong> fix a 600px photo that cannot
      zoom. Size first with the
      <a href="/tools/marketplace-image-prep?platform=amazon">Marketplace Image Resizer</a>, then
      compress if needed.
    </p>

    <h2>Practical file-size targets (seller practice)</h2>
    <ul>
      <li>
        <strong>Platform max:</strong> often cited around <strong>10 MB</strong> per image — stay
        under it, but you rarely need to fill it.
      </li>
      <li>
        <strong>Comfortable upload:</strong> many catalogs land in a few hundred KB to ~2 MB per
        JPEG after resize.
      </li>
      <li>
        <strong>100KB:</strong> optional for web/email — <strong>not</strong> an Amazon requirement.
        Forcing 100KB too hard can add artifacts on fashion or detail shots.
      </li>
    </ul>

    <h2>Recommended workflow</h2>
    <ol>
      <li>Convert HEIC → JPG or PNG/WebP → JPG if needed.</li>
      <li>Resize to Amazon master dimensions (square 2000×2000 is common practice).</li>
      <li>
        <a href="/tools/image-compressor">Compress</a> with quality ~85% or a target KB if files are
        still heavy.
      </li>
      <li>Upload JPEG in Seller Central and spot-check zoom.</li>
    </ol>

    <h2>FAQ</h2>
    <section class="faq">
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </section>

    <RelatedTools
      hide={["compress"]}
      extra={[
        { href: "/tools/image-compressor", label: "Image Compressor" },
        { href: "/tools/marketplace-image-prep?platform=amazon", label: "Amazon image resizer" },
      ]}
    />
    <RelatedGuides
      links={[
        { href: "/guides/amazon-product-image-size", label: "Amazon product image size" },
        { href: "/guides/compress-image-to-100kb", label: "Compress image to 100KB" },
        { href: "/guides/png-to-jpg-for-amazon", label: "PNG to JPG for Amazon" },
        { href: "/guides/heic-to-jpg-for-amazon", label: "HEIC to JPG for Amazon" },
      ]}
    />

    <GuideDisclaimer platforms="Amazon" />
    <ReportIssue />
  </article>
</BaseLayout>
