---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReportIssue from "../../components/ReportIssue.astro";
import RelatedGuides from "../../components/RelatedGuides.astro";
import RelatedTools from "../../components/RelatedTools.astro";

const pageTitle = "Remove Background — White Product Photos (Free)";
const pageDescription =
  "Free remove background tool in your browser. Make Amazon-ready white backgrounds (#FFFFFF) or transparent PNG — batch ZIP, no upload.";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Tools", path: "/#tools" },
  { name: "Remove Background", path: "/tools/background-remover" },
];

const relatedGuides = [
  { href: "/guides/amazon-white-background", label: "Amazon white background guide" },
  { href: "/guides/amazon-product-image-size", label: "Amazon product image size" },
  { href: "/guides/png-to-jpg-for-amazon", label: "PNG to JPG for Amazon" },
  { href: "/guides/compress-image-for-amazon", label: "Compress image for Amazon" },
  { href: "/guides/heic-to-jpg-for-amazon", label: "HEIC to JPG for Amazon" },
];

const faqs: { q: string; a: string }[] = [
  {
    q: "How do I remove background from a product photo?",
    a: "Add JPG, PNG, or WebP files below, choose white JPG or transparent PNG, then Remove background. Processing runs in your browser; download a ZIP when finished.",
  },
  {
    q: "How do I make an Amazon white background (#FFFFFF)?",
    a: "Leave Output on White JPG (#FFFFFF). The tool removes the background and fills with pure white RGB 255,255,255 — the common Amazon main-image background. Confirm current rules in Seller Central.",
  },
  {
    q: "Does this remove background tool upload my images?",
    a: "No. Your product photos stay on your device. The AI model files download once from a CDN into your browser cache; image bytes are not posted to our servers. Check DevTools → Network while running if you want to verify.",
  },
  {
    q: "Can I batch remove backgrounds and download a ZIP?",
    a: "Yes. Drop multiple product photos, process them, and download one ZIP — no account and no ZIP paywall.",
  },
  {
    q: "Can I keep a transparent PNG instead of white?",
    a: "Yes. Set Output to Transparent PNG when you need alpha for design or overlays. For Amazon main images, use White JPG (#FFFFFF).",
  },
  {
    q: "Why is the first run slow?",
    a: "The first run downloads an on-device AI model (about 40–50 MB) into your browser. On a normal connection this often takes 1–3 minutes; slower networks can take longer. If the first CDN fails, the tool automatically retries from a mirror — you do not need a VPN. Later runs reuse the cache and are much faster. Your product photos are not uploaded — only the model files are fetched once.",
  },
  {
    q: "Does this guarantee Amazon 85% product fill?",
    a: "No. This tool removes the background and sets a white (or transparent) canvas. For square sizes and framing, use the Marketplace Image Resizer next, then confirm Seller Central.",
  },
  {
    q: "Can I use HEIC here?",
    a: "Not directly. Convert iPhone HEIC to JPG with the HEIC to JPG converter first, then remove the background here.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const appLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Remove Background — White Product Photos",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: pageDescription,
  url: "https://selltoolhq.com/tools/background-remover",
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/tools/background-remover"
  crumbs={crumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
  </Fragment>

  <section data-bg-remover>
    <p class="badge">No upload · In-browser · Free · Batch ZIP</p>
    <h1>Remove Background for Product Photos</h1>
    <p class="lede">
      Free <strong>remove background</strong> tool for sellers. Make an
      <strong>Amazon white background</strong> (#FFFFFF / RGB 255,255,255) or keep a transparent PNG —
      <strong>batch ZIP</strong>, no signup. Photos stay on your device.
    </p>

    <p class="panel" style="margin-top: 1rem; padding: 0.85rem 1rem; border-left: 3px solid var(--accent);">
      <strong>First run note:</strong> your browser downloads an AI model once (~40–50 MB, often 1–3
      minutes). Progress shows below. Later uses are faster. Photos never leave your device.
    </p>

    <div class="panel">
      <div class="drop" id="dropZone" role="button" tabindex="0" aria-label="Add product photos">
        <p><strong>Drop product photos</strong> (JPG / PNG / WebP) or click to choose</p>
        <input
          id="bgFiles"
          type="file"
          accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
          multiple
          style="pointer-events: none; position: absolute; opacity: 0; width: 0; height: 0;"
        />
      </div>

      <div class="grid-2" style="margin-top: 1rem;">
        <label class="field">
          <span>Output</span>
          <select id="outMode">
            <option value="white-jpg" selected>White JPG (#FFFFFF)</option>
            <option value="png">Transparent PNG</option>
          </select>
        </label>
        <label class="field" id="qualityField">
          <span>JPEG quality <span id="qualityLabel">92%</span></span>
          <input id="quality" type="range" min="70" max="98" value="92" />
        </label>
      </div>

      <p class="status" id="modelProgress" aria-live="polite"></p>
      <ul id="fileList" class="file-list" hidden></ul>
      <p class="status" id="status"></p>

      <div class="actions">
        <button class="btn btn-primary" id="runBtn" type="button">Remove background (white JPG)</button>
        <button class="btn btn-ghost" id="clearBtn" type="button">Clear</button>
      </div>

      <div id="results" class="results" aria-live="polite"></div>
    </div>

    <section class="section">
      <h2>White background for Amazon and other marketplaces</h2>
      <p class="lede">
        Amazon main images commonly require a <strong>pure white background</strong>
        (RGB 255,255,255). Etsy and Shopify sellers also use white product shots for clean catalogs.
        Remove the background here, then size squares with the Marketplace Image Resizer. Always
        confirm current rules in each seller portal.
      </p>
      <div class="table-wrap panel">
        <table class="data">
          <thead>
            <tr>
              <th>Goal</th>
              <th>Output</th>
              <th>Next step</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Amazon main image</td>
              <td>White JPG (#FFFFFF)</td>
              <td>
                <a href="/tools/marketplace-image-prep">Marketplace Image Resizer</a>
              </td>
            </tr>
            <tr>
              <td>Design / overlay</td>
              <td>Transparent PNG</td>
              <td>Keep alpha; composite later</td>
            </tr>
            <tr>
              <td>iPhone HEIC</td>
              <td>—</td>
              <td><a href="/tools/heic-to-jpg">HEIC to JPG</a> first</td>
            </tr>
            <tr>
              <td>File too large after export</td>
              <td>JPG</td>
              <td><a href="/tools/image-compressor">Image Compressor</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section faq">
      <h2>FAQ — Remove background</h2>
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </section>

    <RelatedTools hide={["bg"]} />
    <RelatedGuides links={relatedGuides} />

    <ReportIssue />
  </section>
</BaseLayout>

<script>
  import "../../scripts/background-remover";
</script>
