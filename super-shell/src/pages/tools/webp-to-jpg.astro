---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReportIssue from "../../components/ReportIssue.astro";
import RelatedGuides from "../../components/RelatedGuides.astro";
import RelatedTools from "../../components/RelatedTools.astro";

/**
 * Thin SEO landing for `webp to jpg`.
 * Conversion runs on the PNG / JPG / WebP hub with ?out=jpg — one job, one tool UI.
 */
const hubHref = "/tools/png-to-jpg?out=jpg";
const pageTitle = "WebP to JPG Converter - Free Batch (No Upload)";
const pageDescription =
  "Free WebP to JPG converter for marketplace uploads. Opens our PNG / JPG / WebP hub with JPG selected — batch ZIP, no upload.";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Tools", path: "/#tools" },
  { name: "WebP to JPG", path: "/tools/webp-to-jpg" },
];

const relatedGuides = [
  { href: "/guides/webp-to-jpg", label: "WebP to JPG guide" },
  { href: "/guides/compress-image-for-amazon", label: "Compress images for Amazon" },
  { href: "/guides/amazon-product-image-size", label: "Amazon product image size" },
  { href: "/guides/png-to-jpg-for-amazon", label: "PNG to JPG for Amazon" },
  { href: "/guides/heic-to-jpg-for-amazon", label: "HEIC to JPG for Amazon" },
];

const faqs: { q: string; a: string }[] = [
  {
    q: "How do I convert WebP to JPG?",
    a: "Open the converter hub (JPG is pre-selected), drop your WebP files, then Convert. You get a ZIP download in your browser — no upload.",
  },
  {
    q: "Is this WebP to JPG converter free?",
    a: "Yes. Batch convert WebP to JPEG with no account, no upload, and no ZIP paywall.",
  },
  {
    q: "Are my WebP images uploaded?",
    a: "No. Files stay on your device in the browser converter. Open DevTools → Network while converting if you want to verify.",
  },
  {
    q: "Why convert WebP to JPEG for Amazon?",
    a: "Amazon listing guidance prefers JPEG for product images and does not list WebP as a standard format. Convert WebP to JPG, then confirm in Seller Central.",
  },
  {
    q: "Can I convert multiple WebP files at once?",
    a: "Yes. The hub accepts a batch of WebP images, converts them, and builds one ZIP on your device.",
  },
  {
    q: "What if my WebP has transparency?",
    a: "JPEG has no alpha. Transparent pixels are filled with the background color you pick in the hub (default white).",
  },
  {
    q: "Need PNG to JPG or JPG to PNG instead?",
    a: "Same hub — change the output dropdown to PNG or WebP. This landing is for people searching WebP to JPG.",
  },
  {
    q: "Can I convert HEIC here?",
    a: "No. iPhone HEIC/HEIF belongs in the separate HEIC to JPG converter.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const appLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "WebP to JPG Converter",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: pageDescription,
  url: "https://selltoolhq.com/tools/webp-to-jpg",
};
---

<BaseLayout title={pageTitle} description={pageDescription} path="/tools/webp-to-jpg" crumbs={crumbs}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
  </Fragment>

  <section data-webp-jpg>
    <p class="badge">No upload · In-browser · Free · Opens format hub</p>
    <h1>WebP to JPG Converter</h1>
    <p class="lede">
      Free <strong>WebP to JPG</strong> for product and listing photos. Conversion runs in our
      <strong>PNG / JPG / WebP hub</strong> with <strong>JPG</strong> already selected — batch ZIP,
      no upload, no signup.
    </p>

    <div class="panel webp-landing-cta">
      <p>
        Drop WebP files in the hub, convert to JPEG, download a ZIP. Same engine as PNG ↔ JPG ↔
        WebP — one tool, not a separate converter app.
      </p>
      <div class="actions" style="margin-top: 1rem;">
        <a class="btn btn-primary" href={hubHref}>Convert WebP to JPG</a>
        <a class="btn btn-ghost" href="/tools/png-to-jpg">All formats (PNG / JPG / WebP)</a>
      </div>
    </div>

    <section class="section">
      <h2>Why convert WebP to JPG for sellers</h2>
      <p class="lede">
        Phones, CDNs, and design exports often save <strong>WebP</strong>. Amazon listing guidance
        prefers <strong>JPEG</strong> and does not list WebP as a standard product-image format.
        Convert in the hub first, then size photos with the Marketplace Image Resizer if needed.
        Confirm current rules in Seller Central.
      </p>
      <div class="table-wrap panel">
        <table class="data">
          <thead>
            <tr>
              <th>Situation</th>
              <th>Suggested output</th>
              <th>Next step</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>WebP rejected on Amazon / Etsy upload</td>
              <td>JPG</td>
              <td><a href={hubHref}>Open hub → JPG</a></td>
            </tr>
            <tr>
              <td>Need marketplace pixel sizes</td>
              <td>JPG</td>
              <td>
                <a href="/tools/marketplace-image-prep">Marketplace Image Resizer</a>
              </td>
            </tr>
            <tr>
              <td>Need PNG / other formats</td>
              <td>—</td>
              <td><a href="/tools/png-to-jpg">PNG / JPG / WebP hub</a></td>
            </tr>
            <tr>
              <td>iPhone HEIC</td>
              <td>—</td>
              <td><a href="/tools/heic-to-jpg">HEIC to JPG</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section faq">
      <h2>FAQ — WebP to JPG converter</h2>
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </section>

    <RelatedTools hide={["format"]} />
    <RelatedGuides links={relatedGuides} />

    <ReportIssue />
  </section>
</BaseLayout>
