---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReportIssue from "../../components/ReportIssue.astro";
import RelatedGuides from "../../components/RelatedGuides.astro";
import RelatedTools from "../../components/RelatedTools.astro";

const pageTitle = "PNG to JPG Converter - Free Batch (PNG / JPG / WebP)";
const pageDescription =
  "Free PNG to JPG converter in your browser. Also convert WebP to JPG and JPG to PNG in batch - ZIP download, no upload.";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Tools", path: "/#tools" },
  { name: "PNG to JPG Converter", path: "/tools/png-to-jpg" },
];

const relatedGuides = [
  { href: "/guides/webp-to-jpg", label: "WebP to JPG guide" },
  { href: "/guides/jpg-to-png", label: "JPG to PNG guide" },
  { href: "/guides/png-to-jpg-for-amazon", label: "PNG to JPG for Amazon listings" },
  { href: "/guides/amazon-product-image-size", label: "Amazon product image size" },
  { href: "/guides/heic-to-jpg-for-amazon", label: "HEIC to JPG for Amazon" },
];

const faqs: { q: string; a: string }[] = [
  {
    q: "How do I convert PNG to JPG?",
    a: "Add your PNG files below, set Output to JPG, choose quality and background fill if the PNG has transparency, then Convert. This PNG to JPG converter runs in your browser and lets you download a ZIP.",
  },
  {
    q: "Can I convert WebP to JPG?",
    a: "Yes. Drop WebP images, pick JPG as the output, and convert. WebP to JPG is useful when marketplaces, email, or older tools reject WebP uploads.",
  },
  {
    q: "How do I convert JPG to PNG?",
    a: "Select JPG files, set Output to PNG, then Convert. Use PNG when you need a lossless copy or a format that can keep a transparent background later.",
  },
  {
    q: "Can I batch convert images and download a ZIP?",
    a: "Yes. This free batch image converter accepts multiple PNG, JPG, and WebP files at once - no account and no artificial batch cap - then builds a ZIP on your device.",
  },
  {
    q: "Are my images uploaded to a server?",
    a: "No. Conversion stays on your device. Open DevTools → Network while converting if you want to verify that image bytes are not posted to our servers.",
  },
  {
    q: "What happens to transparent PNG when converting to JPG?",
    a: "JPEG has no transparency. Transparent pixels are filled with the background color you pick (default white), which matches common Amazon main-image practice.",
  },
  {
    q: "Does Amazon accept WebP product images?",
    a: "Amazon listing guidance prefers JPEG and also lists PNG, TIFF, and non-animated GIF - not WebP. Convert WebP to JPG (or PNG) here before uploading, then confirm in Seller Central.",
  },
  {
    q: "Can I convert HEIC here?",
    a: "No. iPhone HEIC/HEIF belongs in the separate HEIC to JPG converter. This tool is for PNG, JPG, and WebP only.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const appLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "PNG to JPG Converter",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: pageDescription,
  url: "https://selltoolhq.com/tools/png-to-jpg",
};
---

<BaseLayout title={pageTitle} description={pageDescription} path="/tools/png-to-jpg" crumbs={crumbs}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
  </Fragment>

  <section data-png-jpg>
    <p class="badge">No upload · In-browser · Free · Batch ZIP</p>
    <h1>PNG to JPG Converter</h1>
    <p class="lede">
      Free <strong>PNG to JPG</strong> converter for listing and product photos. Also
      <strong>convert WebP to JPG</strong> and <strong>JPG to PNG</strong> in one
      <strong>batch image converter</strong> - download a ZIP, no upload, no signup.
    </p>

    <div class="panel">
      <div class="drop" id="dropZone" role="button" tabindex="0" aria-label="Add image files">
        <p><strong>Drop PNG / JPG / WebP</strong> or click to choose</p>
        <input
          id="formatFiles"
          type="file"
          accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
          multiple
        />
      </div>

      <div class="grid-2" style="margin-top: 1rem;">
        <label class="field">
          <span>Output format</span>
          <select id="outFormat">
            <option value="jpg" selected>JPG (JPEG)</option>
            <option value="png">PNG</option>
            <option value="webp">WebP</option>
          </select>
        </label>
        <label class="field" id="qualityField">
          <span>Quality <span id="qualityLabel">92%</span></span>
          <input id="quality" type="range" min="70" max="98" value="92" />
        </label>
        <label class="field" id="fillField">
          <span>JPG background (for transparency)</span>
          <input id="fillColor" type="color" value="#ffffff" />
        </label>
      </div>

      <ul id="fileList" class="file-list" hidden></ul>
      <p class="status" id="status"></p>

      <div class="actions">
        <button class="btn btn-primary" id="convertBtn" type="button">Convert to JPG</button>
        <button class="btn btn-ghost" id="clearBtn" type="button">Clear</button>
      </div>

      <div id="results" class="results" aria-live="polite"></div>
    </div>

    <section class="section">
      <h2>PNG, JPG, and WebP for marketplaces</h2>
      <p class="lede">
        Amazon prefers <strong>JPEG</strong> for most listing images and does not list WebP as a
        standard product-image format. Etsy and TikTok Shop commonly accept <strong>JPG</strong> and
        <strong>PNG</strong>. Convert formats here first, then size photos with the Marketplace Image
        Resizer if needed. Confirm current rules in each seller portal.
      </p>
      <div class="table-wrap panel">
        <table class="data">
          <thead>
            <tr>
              <th>Use case</th>
              <th>Suggested output</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Amazon main / gallery</td>
              <td>JPG</td>
              <td>JPEG preferred; PNG also accepted</td>
            </tr>
            <tr>
              <td>WebP from phone / CDN</td>
              <td>JPG or PNG</td>
              <td>Convert WebP to JPG before upload if rejected</td>
            </tr>
            <tr>
              <td>Need transparency later</td>
              <td>PNG</td>
              <td>JPG cannot keep alpha</td>
            </tr>
            <tr>
              <td>iPhone HEIC</td>
              <td>—</td>
              <td>Use <a href="/tools/heic-to-jpg">HEIC to JPG</a> instead</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section faq">
      <h2>FAQ — PNG to JPG converter</h2>
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </section>

    <RelatedTools hide={["format"]} />
    <RelatedGuides links={relatedGuides} />

    <ReportIssue />
  </section>
</BaseLayout>

<script>
  import "../../scripts/png-to-jpg";
</script>
