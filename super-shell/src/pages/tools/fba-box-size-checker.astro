---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReportIssue from "../../components/ReportIssue.astro";

/** Primary: amazon fba box size. Secondaries woven into title/description/FAQ. */
const pageTitle = "Amazon FBA Box Size Checker — Carton Dimensions & Limits (Free)";
const pageDescription =
  "Free Amazon FBA box size and carton size checker. Verify FBA box dimensions (36×25×25) vs AWD (25×25×25), weight limits, and Pass/Fail — in your browser, no signup.";

const faqs: { q: string; a: string }[] = [
  {
    q: "What is the Amazon FBA box size limit?",
    a: "For US FBA small-parcel inbound cartons, commonly cited Amazon FBA box size limits are 36 inches on the longest side, 25 inches on the other sides, and 50 pounds (length updated Jun 20, 2025). Confirm in Seller Central for your shipment.",
  },
  {
    q: "What are standard FBA box dimensions?",
    a: "Typical FBA box dimensions for small-parcel inbound are up to 36 × 25 × 25 inches after sorting sides so the longest edge is length. This FBA carton size checker sorts L×W×H for you before Pass/Fail.",
  },
  {
    q: "Do FBA and AWD use the same box size?",
    a: "No — AWD vs FBA box size differs. AWD often still uses 25×25×25 inches while FBA allows up to 36 inches in length. Pick the correct program in this tool to match the destination.",
  },
  {
    q: "How do I check FBA carton size before shipping?",
    a: "Enter each carton’s length, width, height, and weight in this free FBA carton size checker, choose FBA or AWD, then Check. You get Pass/Fail plus which rule failed — nothing is uploaded.",
  },
  {
    q: "What if my carton is over 50 pounds?",
    a: "The standard path fails over 50 lb. Heavier cartons may only be allowed for a single oversized/heavy unit with Team Lift (or Mechanical Lift over 100 lb) labeling — check Seller Central.",
  },
  {
    q: "Can a box exceed 36 inches?",
    a: "Only in limited single-oversize-item cases. This tool flags oversize and tells you to confirm exceptions in Seller Central rather than auto-approving.",
  },
  {
    q: "Are my measurements uploaded?",
    a: "No. All math runs in your browser. Open DevTools → Network while checking if you want to verify.",
  },
  {
    q: "Is there a carton limit?",
    a: "No. Check as many cartons as you need in one run — this Amazon FBA box size checker is free with no batch cap.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const appLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Amazon FBA Box Size Checker",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: pageDescription,
  url: "https://minitoolhq.com/tools/fba-box-size-checker",
};
---

<BaseLayout title={pageTitle} description={pageDescription} path="/tools/fba-box-size-checker">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
  </Fragment>

  <section data-fba-box>
    <p class="badge">No upload · In-browser · Free · Unlimited cartons</p>
    <h1>Amazon FBA Box Size Checker</h1>
    <p class="lede">
      Free <strong>Amazon FBA box size</strong> and <strong>carton size checker</strong>. Enter
      inbound <strong>FBA box dimensions</strong> and weight — instant Pass/Fail against common US
      <strong>FBA</strong> (36×25×25, 50 lb) and <strong>AWD</strong> (25×25×25, 50 lb) limits.
      Sides are sorted so the longest edge is treated as length.
    </p>

    <div class="panel">
      <div class="grid-2">
        <fieldset class="field-set">
          <legend>Program</legend>
          <label class="radio"><input type="radio" name="program" value="fba" checked /> FBA inbound</label>
          <label class="radio"><input type="radio" name="program" value="awd" /> AWD inbound</label>
        </fieldset>
        <fieldset class="field-set">
          <legend>Units</legend>
          <label class="radio"><input type="radio" name="units" value="imperial" checked /> in / lb</label>
          <label class="radio"><input type="radio" name="units" value="metric" /> cm / kg</label>
        </fieldset>
      </div>

      <div id="cartonRows" class="carton-rows"></div>

      <p class="status" id="status"></p>

      <div class="actions">
        <button class="btn btn-primary" id="checkBtn" type="button">Check cartons</button>
        <button class="btn btn-ghost" id="addCartonBtn" type="button">Add carton</button>
      </div>

      <div id="results" class="results" aria-live="polite"></div>
    </div>

    <section class="section">
      <h2>Amazon FBA box dimensions &amp; inbound limits (US reference)</h2>
      <p class="lede">
        Figures below summarize widely published FBA box size and AWD carton guidance (including the
        Jun 20, 2025 FBA length change). Always confirm the shipment destination in Seller Central
        before you seal cartons.
      </p>
      <div class="table-wrap panel">
        <table class="data">
          <thead>
            <tr>
              <th>Rule</th>
              <th>FBA</th>
              <th>AWD</th>
              <th>This tool</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Max length (longest side)</td>
              <td>36 in</td>
              <td>25 in</td>
              <td>Fail if over</td>
            </tr>
            <tr>
              <td>Max width / height</td>
              <td>25 × 25 in</td>
              <td>25 × 25 in</td>
              <td>Fail if over</td>
            </tr>
            <tr>
              <td>Max weight (standard)</td>
              <td>50 lb</td>
              <td>50 lb</td>
              <td>Fail + lift notes</td>
            </tr>
            <tr>
              <td>Min size (guide)</td>
              <td>6 × 4 × 1 in</td>
              <td>6 × 4 × 1 in</td>
              <td>Warning if below</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="lede" style="margin-top: 1rem;">
        Not affiliated with Amazon. Passing this check does not guarantee acceptance at a
        fulfillment center.
      </p>
    </section>

    <section class="section faq">
      <h2>FAQ — FBA box size, dimensions &amp; AWD</h2>
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </section>

    <ReportIssue />
  </section>
</BaseLayout>

<script>
  import "../../scripts/fba-box-size-checker";
</script>
